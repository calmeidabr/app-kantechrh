# ============================================================================
# KANTECHRH — EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# ============================================================================

# 1. SUPABASE (Persistência & Multi-Tenant Auth)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anon-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-secreta"

# 2. MOTOR DE CÁLCULO ISOLADO (mam-kantechrh - FastAPI Python)
# No Docker Compose use http://mam-kantechrh:8000
MAM_ENGINE_URL="http://mam-kantechrh:8000"
MAM_INTERNAL_SECRET="kantech-mam-secret-key-2026-isolated"

# 3. GOOGLE GEMINI 2.5 FLASH (OCR & Diagnósticos Executivos)
GEMINI_API_KEY="sua-chave-gemini"
